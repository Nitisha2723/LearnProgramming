<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot Dependencies for Module 11: REST APIs

  These dependencies need to be added to the parent pom.xml at:
  /Users/D069583/myPrivateProjects/LearnProgramming/learn-java/pom.xml

  Add them inside the <dependencies> section.

  NOTE: Spring Boot's parent POM manages versions for you. But since this module
  uses a custom parent pom that doesn't inherit from spring-boot-starter-parent,
  versions are specified explicitly here.

  IMPORTANT: All three spring-boot-starter-* dependencies must use the SAME version.
-->

<!--
  Option 1: Add individual dependencies to your existing pom.xml
  Copy the <dependency> blocks into the <dependencies> section.
-->
<dependencies-to-add>

    <!-- Spring Boot Web: includes Spring MVC, embedded Tomcat, Jackson JSON -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
        <version>3.2.0</version>
    </dependency>

    <!-- Spring Boot Validation: Jakarta Bean Validation (Hibernate Validator) -->
    <!-- Required for @Valid, @NotBlank, @Size, @Email etc. to work -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-validation</artifactId>
        <version>3.2.0</version>
    </dependency>

    <!-- Spring Boot Test: JUnit 5 + MockMvc + Mockito + AssertJ + Spring Test -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-test</artifactId>
        <version>3.2.0</version>
        <scope>test</scope>
    </dependency>

</dependencies-to-add>

<!--
  Option 2: Create a separate Maven module for the REST API
  This is the cleaner approach for a real project.

  Create src/main/java/com/example/todoapi/ inside a new module directory,
  then use this standalone pom.xml for the module:
-->
<standalone-pom-example>
    <!--
    <?xml version="1.0" encoding="UTF-8"?>
    <project xmlns="http://maven.apache.org/POM/4.0.0"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
        <modelVersion>4.0.0</modelVersion>

        <parent>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-parent</artifactId>
            <version>3.2.0</version>
            <relativePath/>
        </parent>

        <groupId>com.example</groupId>
        <artifactId>todo-api</artifactId>
        <version>1.0.0</version>
        <packaging>jar</packaging>

        <properties>
            <java.version>21</java.version>
        </properties>

        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-validation</artifactId>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <scope>test</scope>
            </dependency>
        </dependencies>

        <build>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </build>
    </project>
    -->
</standalone-pom-example>

<!--
  What each starter brings:

  spring-boot-starter-web:
    - spring-webmvc (DispatcherServlet, @RestController, @GetMapping, etc.)
    - spring-boot-starter-tomcat (embedded Tomcat 10.x)
    - jackson-databind (JSON serialization/deserialization)
    - jackson-datatype-jsr310 (LocalDateTime serialization)
    - spring-boot-starter (core Spring Boot auto-configuration)

  spring-boot-starter-validation:
    - hibernate-validator (Jakarta Bean Validation implementation)
    - jakarta.validation-api (@NotNull, @NotBlank, @Size, @Email, etc.)

  spring-boot-starter-test (test scope only):
    - junit-jupiter (JUnit 5)
    - mockito-core (Mockito mocking framework)
    - spring-test (MockMvc, @WebMvcTest, @SpringBootTest)
    - assertj-core (fluent assertions)
    - jsonassert (JSON assertion helpers)
    - json-path (JSONPath for MockMvc assertions)
-->
